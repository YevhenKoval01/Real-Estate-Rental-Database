# Larger deterministic profile for local benchmarks; not used by CI.
RENTAL_DATASET_SIZE=5000
RENTAL_RANDOM_SEED=42
RENTAL_QUALITY_ISSUE_COUNT=0
RENTAL_RENT_ADJUSTMENT=0

# Development-only PostgreSQL defaults used by Compose.
RENTAL_POSTGRES_USER=rental
RENTAL_POSTGRES_PASSWORD=rental_dev
RENTAL_POSTGRES_DATABASE=rental_analytics
RENTAL_POSTGRES_PORT=5432
