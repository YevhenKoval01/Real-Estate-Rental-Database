# PostgreSQL development connection (replace the password outside local development)
RENTAL_POSTGRES_HOST=localhost
RENTAL_POSTGRES_PORT=5432
RENTAL_POSTGRES_USER=rental
RENTAL_POSTGRES_PASSWORD=rental_dev
RENTAL_POSTGRES_DATABASE=rental_analytics

# Generated Bronze inputs and Silver Parquet outputs
RENTAL_BRONZE_PATH=data/bronze
RENTAL_SILVER_PATH=data/silver

# Deterministic small development profile
RENTAL_RANDOM_SEED=42
RENTAL_DATASET_SIZE=12

# Runtime behavior
RENTAL_LOG_LEVEL=INFO
RENTAL_SPARK_MASTER=local[*]
