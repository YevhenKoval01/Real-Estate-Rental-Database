# PostgreSQL development connection (replace the password outside local development)
RENTAL_POSTGRES_HOST=localhost
RENTAL_POSTGRES_PORT=5432
RENTAL_POSTGRES_USER=rental
RENTAL_POSTGRES_PASSWORD=rental_dev
RENTAL_POSTGRES_DATABASE=rental_analytics

# Generated source, Bronze, quality, rejected, and Silver outputs
RENTAL_SOURCE_PATH=data/source
RENTAL_BRONZE_PATH=data/bronze
RENTAL_QUALITY_PATH=data/quality
RENTAL_REJECTED_PATH=data/rejected
RENTAL_SILVER_PATH=data/silver

# Deterministic small development profile
RENTAL_RANDOM_SEED=42
RENTAL_DATASET_SIZE=12
RENTAL_QUALITY_ISSUE_COUNT=0
RENTAL_RENT_ADJUSTMENT=0

# Runtime behavior
RENTAL_LOG_LEVEL=INFO
RENTAL_SPARK_MASTER=local[*]
RENTAL_DBT_PROJECT_PATH=warehouse/dbt
RENTAL_BI_MODEL_PATH=bi/Rental Analytics.SemanticModel

# Optional Airflow profile (development credentials only)
AIRFLOW_PORT=8080
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
