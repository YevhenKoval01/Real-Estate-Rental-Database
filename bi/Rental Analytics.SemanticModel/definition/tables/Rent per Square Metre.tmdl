/// Weighted asking-rent per square metre across the current property inventory.
table 'Rent per Square Metre'

	measure 'Average Rent per Square Metre' = DIVIDE(SUMX('Rent per Square Metre', 'Rent per Square Metre'[average_rent_per_sqm] * 'Rent per Square Metre'[property_count]), SUM('Rent per Square Metre'[property_count]))
		formatString: #,0.00 "PLN/m²"
		displayFolder: Core KPIs

	column city
		dataType: string
		sourceColumn: city
		summarizeBy: none

	column region
		dataType: string
		sourceColumn: region
		summarizeBy: none

	column property_count
		dataType: int64
		sourceColumn: property_count
		summarizeBy: sum

	column average_rent_per_sqm
		dataType: decimal
		sourceColumn: average_rent_per_sqm
		summarizeBy: none

	partition 'Rent per Square Metre' = m
		mode: import
		source =
			let
				Source = PostgreSQL.Database(DatabaseServer, DatabaseName, [Query = "select city, region, property_count, average_rent_per_sqm from analytics_marts.mart_average_rent_per_sqm"])
			in
				Source
